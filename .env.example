DATABASE_URL=postgresql://creatives:change-local-db-password@localhost:55432/creatives
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
# Optional public S3 URL used to sign browser uploads (same service/region); defaults to S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=creatives
S3_FORCE_PATH_STYLE=true
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_TEXT=
# Image-capable model ID for video frame descriptions; confirm it in api-docs.deepseek.com/guides/vision/.
DEEPSEEK_MODEL_VISION=
# Development and automated tests only: "fake" answers with a scripted model and never calls DeepSeek. Refused when NODE_ENV=production.
AI_PROVIDER=
GROQ_API_KEY=
GROQ_WHISPER_MODEL=
# Monthly AI spend per operation in BRL cents (2000 = R$ 20) and provider prices in BRL cents per million tokens. Empty uses the defaults.
AI_MONTHLY_LIMIT_CENTS=
AI_PRICE_INPUT_CENTS_PER_MTOK=
AI_PRICE_CACHED_INPUT_CENTS_PER_MTOK=
AI_PRICE_OUTPUT_CENTS_PER_MTOK=
# Password reset by email through Resend. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Hotmart purchase webhook: the account's hottok and the product ids (comma-separated) that grant access.
HOTMART_HOTTOK=
HOTMART_PRODUCT_IDS=
# Development and automated tests only: write emails as JSON files to this folder instead of sending. Refused when NODE_ENV=production.
EMAIL_OUTBOX_DIR=
# Generate 32 random bytes encoded as base64.
ENCRYPTION_KEY=
# Optional daily backup to an S3-compatible bucket (see docs/ativacao.md). Off while BACKUP_S3_BUCKET is empty.
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_BUCKET=
# BACKUP_S3_FORCE_PATH_STYLE=false
# BACKUP_ENCRYPTION_KEY=
# Local Compose infrastructure; set unique credentials before starting.
POSTGRES_USER=creatives
POSTGRES_PASSWORD=change-local-db-password
POSTGRES_DB=creatives
POSTGRES_PORT=55432
# Only for npm run test:attribution: an empty database whose name ends in _test.
# TEST_DATABASE_URL=
