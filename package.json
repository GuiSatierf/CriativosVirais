{
  "name": "criativos-virais",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && npm run build:worker && npm run build:tools",
    "build:worker": "esbuild src/worker.ts --bundle --platform=node --target=node22 --packages=external --outfile=dist/worker.js",
    "start": "node scripts/start.mjs",
    "worker": "node dist/worker.js",
    "lint": "oxlint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "storage:init": "tsx scripts/init-storage.ts",
    "build:tools": "esbuild src/db/migrate.ts scripts/init-storage.ts scripts/doctor.ts --bundle --platform=node --target=node22 --packages=external --outdir=dist/tools",
    "test": "vitest run",
    "setup:env": "node scripts/setup-env.mjs",
    "doctor": "tsx scripts/doctor.ts",
    "check:security": "node scripts/check-braces.mjs",
    "test:attribution": "tsx --conditions=react-server scripts/check-attribution.ts",
    "seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "test:e2e": "npm run build:worker && playwright test"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.64",
    "@ai-sdk/react": "^4.0.142",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@phosphor-icons/react": "2.1.10",
    "ai": "^7.0.139",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "docx": "^9.11.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.3",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "braces": "file:vendor/criativosvirais-braces-3.0.3-patch.1.tgz",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    },
    "braces": "$braces"
  }
}
